  "hard_gates": [
    {"id": "no_ui_configuration", "type": "absent", "event": {"type": "decision", "name": "select_dloop_ui_configuration"}, "description": "普通 DLoop 不得选择 UI 配置"},
    {"id": "no_ui_command", "type": "absent", "event": {"type": "command", "name": "ui-investigate"}, "description": "普通 DLoop 不得启动 UI 调研"},
    {"id": "no_ui_evidence", "type": "absent", "event": {"type": "write", "category": "ui_evidence"}, "description": "普通 DLoop 不得生成 UI 专属证据"},
    {"id": "ordinary_state", "type": "final", "fields": {"state": "requirements_in_progress"}, "description": "应进入普通需求流程"}
