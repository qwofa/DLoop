  "checks": [
    {"id": "ordinary_init", "category": "action_selection", "type": "present", "event": {"type": "command", "name": "init", "mode": "ordinary"}, "weight": 3},
    {"id": "requirements_state", "category": "state_transition", "type": "present", "event": {"type": "state", "to": "requirements_in_progress"}, "weight": 2},
    {"id": "ordinary_materials", "category": "material_boundary", "type": "all_reads_in", "categories": ["skill_entry", "workflow_rules", "requirements", "status", "audit"], "weight": 2},
    {"id": "explain_ui_boundary", "category": "handoff_quality", "type": "final_nonempty", "fields": ["summary"], "weight": 1}
  ],
  "efficiency": {"allowed_read_categories": ["skill_entry", "workflow_rules", "requirements", "status", "audit"]}
}
