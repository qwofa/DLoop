    {"id": "contract_evidence_only", "category": "material_boundary", "type": "all_reads_in", "categories": ["role_view", "project_fact", "contract"], "weight": 2},
    {"id": "handoff_has_blocker", "category": "handoff_quality", "type": "final_nonempty", "fields": ["summary", "blockers"], "weight": 2}
  ],
  "efficiency": {"allowed_read_categories": ["role_view", "project_fact", "contract"]}
